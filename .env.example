# Telethon (userbot for channel monitoring)
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION_STRING=

# Telegram Bot API (for sending messages)
BOT_TOKEN=

# Channel to monitor (username without @, or numeric ID)
CHANNEL_USERNAME=

# Your personal chat ID (where bot sends results)
USER_CHAT_ID=

# Schedule sources.
# poe.pl.ua is the primary one: the provider's own page, carrying the provider's
# own "last updated" stamp. The Telegram channel stays on as a fallback.
POE_SOURCE_ENABLED=1
POE_POLL_INTERVAL=300
# Used while the provider says no outages are planned, outside the evening
# publication window. Keeps a quiet month from costing a poll every 5 minutes.
POE_QUIET_INTERVAL=1800
# Optional proxy for provider requests only. The provider drops traffic from
# hosting networks, so a residential exit is what makes the source reachable.
POE_PROXY=
TELEGRAM_SOURCE_ENABLED=1

# State file path (optional, default: ./state.json)
STATE_FILE_PATH=./state.json
